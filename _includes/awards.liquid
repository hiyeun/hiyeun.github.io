<div class="awards-gallery">
  <div class="row row-cols-1 row-cols-md-3">
    {% for award in site.data.awards %}
      <div class="col mb-4">
        <button
          type="button"
          class="award-card-button"
          data-award-title="{{ award.title | escape }}"
          data-award-event="{{ award.event | escape }}"
          aria-label="View certificate for {{ award.title | escape }}"
        >
          <div class="card h-100 hoverable award-card">
            <div class="award-image-wrap">
              <div class="award-image-placeholder" aria-hidden="true">
                <i class="fa-solid fa-award"></i>
              </div>
              <iframe
                class="award-source-frame"
                src="{{ award.proof_url | relative_url }}"
                title="{{ award.title | escape }} certificate"
                loading="eager"
                tabindex="-1"
                aria-hidden="true"
              ></iframe>
            </div>
            <div class="card-body">
              <div class="award-year">{{ award.year }}</div>
              <h2 class="card-title">{{ award.title }}</h2>
              <p class="card-text award-event">{{ award.event }}</p>
              <p class="award-issuer">{{ award.issuer }}</p>
            </div>
          </div>
        </button>
      </div>
    {% endfor %}
  </div>
</div>

<div id="award-modal" class="award-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="award-modal-title">
  <button type="button" class="award-modal-close" aria-label="Close certificate viewer">&times;</button>
  <div class="award-modal-content">
    <img id="award-modal-image" alt="Award certificate">
    <div class="award-modal-caption">
      <strong id="award-modal-title"></strong>
      <span id="award-modal-event"></span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cards = document.querySelectorAll('.award-card-button');
    const modal = document.getElementById('award-modal');
    const modalImage = document.getElementById('award-modal-image');
    const modalTitle = document.getElementById('award-modal-title');
    const modalEvent = document.getElementById('award-modal-event');
    const closeButton = modal.querySelector('.award-modal-close');

    function prepareCertificateFrame(card) {
      const frame = card.querySelector('.award-source-frame');
      const placeholder = card.querySelector('.award-image-placeholder');

      try {
        const doc = frame.contentDocument || frame.contentWindow.document;
        const sourceImage = doc.querySelector('img');
        if (!sourceImage || !sourceImage.getAttribute('src')) return null;

        const imageSrc = sourceImage.getAttribute('src');
        card.dataset.imageSrc = imageSrc;

        doc.documentElement.style.width = '100%';
        doc.documentElement.style.height = '100%';
        doc.documentElement.style.overflow = 'hidden';
        doc.body.innerHTML = '';
        doc.body.style.margin = '0';
        doc.body.style.width = '100%';
        doc.body.style.height = '100%';
        doc.body.style.overflow = 'hidden';
        doc.body.style.background = '#ffffff';

        const image = doc.createElement('img');
        image.src = imageSrc;
        image.alt = card.dataset.awardTitle + ' certificate';
        image.style.display = 'block';
        image.style.width = '100%';
        image.style.height = '100%';
        image.style.objectFit = 'contain';
        image.style.objectPosition = 'center';
        image.style.filter = 'none';
        image.style.webkitFilter = 'none';
        image.style.opacity = '1';
        image.style.mixBlendMode = 'normal';
        doc.body.appendChild(image);

        frame.classList.add('is-loaded');
        if (placeholder) placeholder.classList.add('is-hidden');
        return imageSrc;
      } catch (error) {
        console.warn('Unable to prepare award certificate:', error);
        return null;
      }
    }

    function openModal(card) {
      const imageSrc = card.dataset.imageSrc || prepareCertificateFrame(card);
      if (!imageSrc) return;

      modalImage.src = imageSrc;
      modalTitle.textContent = card.dataset.awardTitle || '';
      modalEvent.textContent = card.dataset.awardEvent || '';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('award-modal-open');
      closeButton.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modalImage.removeAttribute('src');
      document.body.classList.remove('award-modal-open');
    }

    cards.forEach(function (card) {
      const frame = card.querySelector('.award-source-frame');
      frame.addEventListener('load', function () {
        prepareCertificateFrame(card);
      });

      card.addEventListener('click', function () {
        openModal(card);
      });
    });

    closeButton.addEventListener('click', closeModal);
    modal.addEventListener('click', function (event) {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });
  });
</script>
